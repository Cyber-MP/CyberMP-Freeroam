{
  "name": "cybermp-freeroam",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:build": "pnpm run -r --parallel --filter ./resources/** dev",
    "build": "pnpm run -r --filter ./resources/** build",
    "dev:docker": "docker compose -f ./docker-compose.dev.yml up",
    "docker": "docker compose up -d",
    "dev:win": "cross-env NODE_ENV=development ./mp/win/CyberMP-Server.exe -run -rdir=./resources",
    "win": "cross-env NODE_ENV=production ./mp/win/CyberMP-Server.exe -run -rdir=./resources",
    "dev:linux": "cross-env NODE_ENV=development ./mp/linux/cybermp-server -run -rdir=$(pwd)/resources",
    "linux": "cross-env NODE_ENV=production ./mp/linux/cybermp-server -run -rdir=$(pwd)/resources",
    "type:check": "pnpm run -r --filter ./resources/** type:check",
    "biome:lint": "biome lint --write ./resources",
    "biome:format": "biome format --write ./resources",
    "biome:check": "biome check --write ./resources",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm type:check",
    "pre-push": "pnpm type:check"
  },
  "keywords": [],
  "author": "terminaate",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "cross-env": "^7.0.3",
    "simple-git-hooks": "^2.13.1",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3"
  }
}
